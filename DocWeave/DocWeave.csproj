<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Also required for the missing-XML-documentation rule (CS1591) in .editorconfig to report anything. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- NuGet package metadata. PackageId defaults to the project name (DocWeave). -->
    <Version>0.1.0</Version>
    <Title>DocWeave</Title>
    <Authors>Francois Roux</Authors>
    <Company>Francois Roux</Company>
    <Product>DocWeave</Product>
    <PackageId>DocWeave</PackageId>
    <PackageCopyright>Copyright © 2026 Francois</PackageCopyright>
    <Description>Fluent API and JSON templates for exporting and importing Excel (.xlsx) and CSV files, built on the Open XML SDK. Supports styled tables, formulas, charts, pivot tables, data validation and typed CSV import.</Description>
    <PackageReleaseNotes>Initial preview package for modern .NET. Includes Excel and CSV import/export, JSON template-driven exports/imports, Web API contract DTOs, and progress/cancellation/audit hooks.</PackageReleaseNotes>
    <PackageTags>excel;xlsx;csv;openxml;export;import;pivot-table;fluent</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/FrancoisAR/DocWeave</PackageProjectUrl>
    <RepositoryUrl>https://github.com/FrancoisAR/DocWeave.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- <GeneratePackageOnBuild>true</GeneratePackageOnBuild> -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The repository README is shown on nuget.org. -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>
