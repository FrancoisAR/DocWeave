<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Also required for the missing-XML-documentation rule (CS1591) in .editorconfig to report anything. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package metadata. PackageId defaults to the project name (DocWeave). -->
  <PropertyGroup>
    <Version>0.1.0-preview.1</Version>
    <Authors>Francois</Authors>
    <Description>Fluent API and JSON templates for exporting and importing Excel (.xlsx) and CSV files, built on the Open XML SDK. Supports styled tables, formulas, charts, pivot tables, data validation and typed CSV import.</Description>
    <PackageTags>excel;xlsx;csv;openxml;export;import;pivot-table;fluent</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Set these once the repository has a public home:
    <RepositoryUrl>https://github.com/OWNER/REPO</RepositoryUrl>
    <PackageProjectUrl>https://github.com/OWNER/REPO</PackageProjectUrl>
    -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- The repository README is shown on nuget.org. -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>

</Project>
