<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>DocWeaveNS</AssemblyName>
    <RootNamespace>DocWeave</RootNamespace>
    <PackageId>DocWeaveNS</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>Francois</Authors>
    <Description>.NET Standard 2.0 compatible variant of DocWeave for importing and exporting Excel (.xlsx) and CSV files from .NET Framework applications.</Description>
    <PackageTags>excel;xlsx;csv;openxml;export;import;netstandard;netfx</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="System.Text.Json" Version="9.0.9" />
  </ItemGroup>

</Project>
